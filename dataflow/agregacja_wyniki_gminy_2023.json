				"     schemaName: 'dbo',",
				"     tableName: 'Fakt_Wyniki_2023',",
				"     isolationLevel: 'READ_UNCOMMITTED') ~> ReadWyniki2023",
				"ReadWyniki2023 aggregate(groupBy(Gmina),",
				"     {Liczba Komisji} = toInteger(count(ID_KOMISJI)),",
				"          Liczba_Wyborcow = toInteger(sum(Liczba_Wyborcow)),",
				"          Komisja_Otrzymala_Karty = toInteger(sum(Komisja_Otrzymala_Karty)),",
				"          Niewykorzystane_Karty = toInteger(sum(Niewykorzystane_Karty)),",
				"          Wydane_Karty = toInteger(sum(Wydane_Karty)),",
				"          Liczba_Wyborcow_Pelnomocnik = toInteger(sum(Liczba_Wyborcow_Pelnomocnik)),",
				"          Liczba_Wyborcow_Zaswiadczenie = toInteger(sum(Liczba_Wyborcow_Zaswiadczenie)),",
				"          Liczba_Otrzymanych_Kopert = toInteger(sum(Liczba_Otrzymanych_Kopert)),",
				"          Koperty_Brak_Oswiadczenia = toInteger(sum(Koperty_Brak_Oswiadczenia)),",
				"          Koperty_Brak_Podpisu = toInteger(sum(Koperty_Brak_Podpisu)),",
				"          Koperty_Brak_Karty = toInteger(sum(Koperty_Brak_Karty)),",
				"          Niezaklejona_Koperta = toInteger(sum(Niezaklejona_Koperta)),",
				"          Koperty_Do_Urny = toInteger(sum(Koperty_Do_Urny)),",
				"          Karty_Z_Urny = toInteger(sum(Karty_Z_Urny)),",
				"          Karty_Z_Kopert = toInteger(sum(Karty_Z_Kopert)),",
				"          Karty_Niewazne = toInteger(sum(Karty_Niewazne)),",
				"          Karty_Wazne = toInteger(sum(Karty_Wazne)),",
				"          Glosy_Niewazne = toInteger(sum(Glosy_Niewazne)),",
				"          Glosy_X_Wielu_Kandydatow = toInteger(sum(Glosy_X_Wielu_Kandydatow)),",
				"          Glosy_Brak_X = toInteger(sum(Glosy_Brak_X)),",
				"          Glosy_X_Uniewazniona_Lista = toInteger(sum(Glosy_X_Uniewazniona_Lista)),",
