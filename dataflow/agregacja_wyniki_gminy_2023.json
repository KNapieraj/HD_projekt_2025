				"          Glosy_Niewazne_Suma as integer,",
				"          Glosy_X_Wielu_Kandydatow_Suma as integer,",
				"          Glosy_Brak_X_Suma as integer,",
				"          Glosy_X_Uniewazniona_Lista_Suma as integer,",
				"          Glosy_Wazne_Suma as integer,",
				"          KW_Bezpartyjni_Samorzadowcy_Suma as integer,",
				"          KW_Trzecia_Droga_Polska_2050_PSL_Suma as integer,",
				"          KW_Nowa_Lewica_Suma as integer,",
				"          KW_PIS_Suma as integer,",
				"          KW_KONFEDERACJA_Suma as integer,",
				"          KW_KOALICJA_OBYWATELSKA_Suma as integer,",
				"          KW_Polska_Jest_Jedna_Suma as integer,",
				"          KW_Ruch_Dobrobytu_Pokoju_Suma as integer,",
				"          KW_Normalny_Kraj_Suma as integer,",
				"          KW_Antypartia_Suma as integer,",
				"          KW_Ruch_Naprawy_Polski_Suma as integer,",
				"          KW_Mniejszosc_Niemiecka_Suma as integer,",
				"          Data as date",
				"     ),",
				"     format: 'table',",
				"     store: 'sqlserver',",
				"     schemaName: 'dbo',",
				"     tableName: 'Fakt_Agregowane_Gmina_2023',",
				"     insertable: true,",
				"     updateable: false,",
				"     deletable: false,",
				"     upsertable: true,",
				"     keys:['Gmina'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
