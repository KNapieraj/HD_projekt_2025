				"          KW_KONFEDERACJA = toInteger(sum(KW_KONFEDERACJA)),",
				"          KW_Nowa_Lewica = toInteger(sum(KW_Nowa_Lewica)),",
				"          KW_Trzecia_Droga_Polska_2050_PSL = toInteger(sum(KW_Trzecia_Droga_Polska_2050_PSL)),",
				"          KW_Bezpartyjni_Samorzadowcy = toInteger(sum(KW_Bezpartyjni_Samorzadowcy)),",
				"          KW_Polska_Jest_Jedna = toInteger(sum(KW_Polska_Jest_Jedna)),",
				"          KW_Ruch_Dobrobytu_Pokoju = toInteger(sum(KW_Ruch_Dobrobytu_Pokoju)),",
				"          KW_Normalny_Kraj = toInteger(sum(KW_Normalny_Kraj)),",
