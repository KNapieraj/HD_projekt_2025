				"          Liczba_Wyborcow_Suma as integer,",
				"          Komisja_Otrzymala_Karty_Suma as integer,",
				"          Niewykorzystane_Karty_Suma as integer,",
				"          Wydane_Karty_Suma as integer,",
				"          Liczba_Wyborcow_Pelnomocnik_Suma as integer,",
				"          Liczba_Wyborcow_Zaswiadczenie_Suma as integer,",
