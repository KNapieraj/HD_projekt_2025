				"          Komisja_Otrzymala_Karty_Suma = Komisja_Otrzymala_Karty,",
				"          Niewykorzystane_Karty_Suma = Niewykorzystane_Karty,",
				"          Wydane_Karty_Suma = Wydane_Karty,",
				"          Liczba_Wyborcow_Pelnomocnik_Suma = Liczba_Wyborcow_Pelnomocnik,",
				"          Liczba_Wyborcow_Zaswiadczenie_Suma = Liczba_Wyborcow_Zaswiadczenie,",
				"          Liczba_Otrzymanych_Kopert_Suma = Liczba_Otrzymanych_Kopert,",
				"          Koperty_Brak_Oswiadczenia_Suma = Koperty_Brak_Oswiadczenia,",
				"          Koperty_Brak_Podpisu_Suma = Koperty_Brak_Podpisu,",
				"          Koperty_Brak_Karty_Suma = Koperty_Brak_Karty,",
				"          Niezaklejona_Koperta_Suma = Niezaklejona_Koperta,",
				"          Koperty_Do_Urny_Suma = Koperty_Do_Urny,",
				"          Karty_Z_Urny_Suma = Karty_Z_Urny,",
				"          Karty_Z_Kopert_Suma = Karty_Z_Kopert,",
				"          Karty_Niewazne_Suma = Karty_Niewazne,",
				"          Karty_Wazne_Suma = Karty_Wazne,",
				"          Glosy_Niewazne_Suma = Glosy_Niewazne,",
				"          Glosy_X_Wielu_Kandydatow_Suma = Glosy_X_Wielu_Kandydatow,",
				"          Glosy_Brak_X_Suma = Glosy_Brak_X,",
				"          Glosy_X_Uniewazniona_Lista_Suma = Glosy_X_Uniewazniona_Lista,",
				"          Glosy_Wazne_Suma = Glosy_Wazne,",
				"          KW_Bezpartyjni_Samorzadowcy_Suma = KW_Bezpartyjni_Samorzadowcy,",
				"          KW_Trzecia_Droga_Polska_2050_PSL_Suma = KW_Trzecia_Droga_Polska_2050_PSL,",
				"          KW_Nowa_Lewica_Suma = KW_Nowa_Lewica,",
				"          KW_PIS_Suma = KW_PIS,",
				"          KW_KONFEDERACJA_Suma = KW_KONFEDERACJA,",
				"          KW_KOALICJA_OBYWATELSKA_Suma = KW_KOALICJA_OBYWATELSKA,",
				"          KW_Polska_Jest_Jedna_Suma = KW_Polska_Jest_Jedna,",
				"          KW_Ruch_Dobrobytu_Pokoju_Suma = KW_Ruch_Dobrobytu_Pokoju,",
				"          KW_Normalny_Kraj_Suma = KW_Normalny_Kraj,",
				"          KW_Antypartia_Suma = KW_Antypartia,",
				"          KW_Ruch_Naprawy_Polski_Suma = KW_Ruch_Naprawy_Polski,",
				"          KW_Mniejszosc_Niemiecka_Suma = KW_Mniejszosc_Niemiecka,",
				"          Data",
				"     )) ~> loadAgregacjaWynikiGmina2023"
			]
