				"          KW_KOALICJA_OBYWATELSKA as integer,",
				"          KW_Polska_Jest_Jedna as integer,",
				"          KW_Ruch_Dobrobytu_Pokoju as integer,",
				"          KW_Normalny_Kraj as integer,",
				"          KW_Antypartia as integer,",
				"          KW_Ruch_Naprawy_Polski as integer,",
				"          KW_Mniejszosc_Niemiecka as integer,",
				"          Data as date",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table',",
