				"          KW_Ruch_Naprawy_Polski = toInteger(sum(KW_Ruch_Naprawy_Polski)),",
				"          KW_Mniejszosc_Niemiecka = toInteger(sum(KW_Mniejszosc_Niemiecka))) ~> aggregate2023",
