{
	"name": "etl_obwody_2019",
	"properties": {
		"folder": {
			"name": "ETL"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "plikicsv",
						"type": "LinkedServiceReference"
					},
					"name": "obwody2019"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "SQLDatabase",
						"type": "LinkedServiceReference"
					},
					"name": "LoadWymiarObwody2019",
					"description": "LoadObwody2019"
				},
				{
					"linkedService": {
						"referenceName": "SQLDatabase",
						"type": "LinkedServiceReference"
					},
					"name": "LoadWymiarGmina2019"
				},
				{
					"linkedService": {
						"referenceName": "SQLDatabase",
						"type": "LinkedServiceReference"
					},
					"name": "LoadWymiarCzas2019"
				}
			],
			"transformations": [
				{
					"name": "IDandRokObwody2019",
					"description": "Added \n-ID KOMISJI \n-ROK 2019"
				},
				{
					"name": "RemoveColumnsObwody2019",
					"description": "Remove:\nPelna siedziba,\nOpis granic\nPowiat"
				},
				{
					"name": "alterRowWymiarObwody2019"
				},
				{
					"name": "AgregateWymiarGmina2019"
				},
				{
					"name": "alterRowWymiarGmina2019"
				},
				{
					"name": "AddedRokWymiarGmina2019"
				},
				{
					"name": "aggregateWymiarCzas2019"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "alterRowWymiarCzas2019"
				}
			],
			"scriptLines": [
				"source(output(",
				"          {KOD TERYTORIALNY} as integer,",
				"          Gmina as string,",
				"          Powiat as string,",
				"          {Numer obwodu} as integer,",
				"          {Mieszkańcy} as integer,",
				"          Wyborcy as integer,",
				"          Siedziba as string,",
				"          {Miejscowość} as string,",
				"          Ulica as string,",
				"          {Numer posesji} as string,",
				"          {Numer lokalu} as string,",
				"          {Kod pocztowy} as string,",
				"          Poczta as string,",
				"          {Typ obwodu} as string,",
				"          {Przystosowany dla niepełnosprawnych} as string,",
				"          {Typ obszaru} as string,",
				"          {Pełna siedziba} as string,",
				"          {Opis granic} as string,",
				"          {Numer okręgu do Sejmu} as integer,",
				"          {Numer okręgu do Senatu} as integer",
				"     ),",
				"     useSchema: false,",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'delimited',",
				"     container: 'plikicsv',",
				"     fileName: 'obwody_glosowania_2019.csv',",
				"     columnDelimiter: ';',",
				"     escapeChar: '\\\\',",
				"     quoteChar: '\\\"',",
				"     columnNamesAsHeader: true) ~> obwody2019",
				"RemoveColumnsObwody2019 derive({ID KOMISJI} = toInteger(concat(toString({KOD TERYTORIALNY}), toString({Numer obwodu}))),",
				"          DATA = toDate('13-10-2019', 'dd-MM-yyyy'),",
				"          {Przystosowany dla niepełnosprawnych} = case({Przystosowany dla niepełnosprawnych string} == 'Tak', 'T', 'N')) ~> IDandRokObwody2019",
				"obwody2019 select(mapColumn(",
				"          {KOD TERYTORIALNY},",
				"          Gmina,",
				"          {Numer obwodu},",
				"          {Mieszkańcy},",
				"          Wyborcy,",
				"          Siedziba,",
				"          {Miejscowość},",
				"          Ulica,",
				"          {Numer posesji},",
				"          {Numer lokalu},",
				"          {Kod pocztowy},",
				"          Poczta,",
				"          {Typ obwodu},",
				"          {Przystosowany dla niepełnosprawnych string} = {Przystosowany dla niepełnosprawnych},",
				"          {Typ obszaru},",
				"          {Numer okręgu do Sejmu},",
				"          {Numer okręgu do Senatu}",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> RemoveColumnsObwody2019",
				"IDandRokObwody2019 alterRow(upsertIf(true())) ~> alterRowWymiarObwody2019",
				"IDandRokObwody2019 aggregate(groupBy(Gmina),",
				"     {Mieszkańcy} = toInteger(sum({Mieszkańcy})),",
				"          Wyborcy = toInteger(sum(Wyborcy)),",
				"          {Liczba Komisji} = toInteger(count({ID KOMISJI}))) ~> AgregateWymiarGmina2019",
				"AddedRokWymiarGmina2019 alterRow(upsertIf(true())) ~> alterRowWymiarGmina2019",
				"AgregateWymiarGmina2019 derive(ROK = toDate('13-10-2019', 'dd-MM-yyyy')) ~> AddedRokWymiarGmina2019",
				"IDandRokObwody2019 aggregate(groupBy(DATA),",
				"     {Mieszkańcy} = toInteger(sum({Mieszkańcy})),",
				"          Wyborcy = toInteger(sum(Wyborcy)),",
				"          {Liczba Komisji} = toInteger(count({ID KOMISJI}))) ~> aggregateWymiarCzas2019",
				"aggregateWymiarCzas2019 derive(Dzien = toInteger(13),",
				"          Miesiac = toInteger(10),",
				"          Rok = toInteger(2019)) ~> derivedColumn2",
				"derivedColumn2 alterRow(upsertIf(true())) ~> alterRowWymiarCzas2019",
				"alterRowWymiarObwody2019 sink(allowSchemaDrift: true,",
				"     validateSchema: true,",
				"     input(",
				"          ID_KOMISJI as integer,",
				"          KOD_TERYTORIALNY as integer,",
				"          Gmina as string,",
				"          Numer_obwodu as integer,",
				"          Numer_okregu_do_Sejmu as integer,",
				"          Numer_okregu_do_Senatu as integer,",
				"          Mieszkancy as integer,",
				"          Wyborcy as integer,",
				"          Siedziba as string,",
				"          Ulica as string,",
				"          Numer_posesji as string,",
				"          Numer_lokalu as string,",
				"          Miejscowosc as string,",
				"          Kod_pocztowy as string,",
				"          Poczta as string,",
				"          Przystosowany_dla_niepelnosprawnych as string,",
				"          Typ_obszaru as string,",
				"          Typ_obwodu as string,",
				"          Data as date",
				"     ),",
				"     format: 'table',",
				"     store: 'sqlserver',",
				"     schemaName: 'dbo',",
				"     tableName: 'Wymiar_Obwody_2019',",
				"     insertable: true,",
				"     updateable: false,",
				"     deletable: false,",
				"     upsertable: true,",
				"     keys:['ID_KOMISJI'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          ID_KOMISJI = {ID KOMISJI},",
				"          KOD_TERYTORIALNY = {KOD TERYTORIALNY},",
				"          Gmina,",
				"          Numer_obwodu = {Numer obwodu},",
				"          Numer_okregu_do_Sejmu = {Numer okręgu do Sejmu},",
				"          Numer_okregu_do_Senatu = {Numer okręgu do Senatu},",
				"          Mieszkancy = {Mieszkańcy},",
				"          Wyborcy,",
				"          Siedziba,",
				"          Ulica,",
				"          Numer_posesji = {Numer posesji},",
				"          Numer_lokalu = {Numer lokalu},",
				"          Miejscowosc = {Miejscowość},",
				"          Kod_pocztowy = {Kod pocztowy},",
				"          Poczta,",
				"          Przystosowany_dla_niepelnosprawnych = {Przystosowany dla niepełnosprawnych},",
				"          Typ_obszaru = {Typ obszaru},",
				"          Typ_obwodu = {Typ obwodu},",
				"          Data = DATA",
				"     )) ~> LoadWymiarObwody2019",
				"alterRowWymiarGmina2019 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          Nazwa as string,",
				"          {Mieszkańcy} as integer,",
				"          Wyborcy as integer,",
				"          Liczba_Komisji as integer,",
				"          Data as date",
				"     ),",
				"     format: 'table',",
				"     store: 'sqlserver',",
				"     schemaName: 'dbo',",
				"     tableName: 'Wymiar_Gmina_2019',",
				"     insertable: true,",
				"     updateable: false,",
				"     deletable: false,",
				"     upsertable: true,",
				"     keys:['Nazwa'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          Nazwa = Gmina,",
				"          {Mieszkańcy},",
				"          Wyborcy,",
				"          Liczba_Komisji = {Liczba Komisji},",
				"          Data = ROK",
				"     )) ~> LoadWymiarGmina2019",
				"alterRowWymiarCzas2019 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          Data as date,",
				"          Dzien as integer,",
				"          Miesiac as integer,",
				"          Rok as integer,",
				"          Mieszkancy as integer,",
				"          Wyborcy as integer,",
				"          Liczba_Komisji as integer",
				"     ),",
				"     format: 'table',",
				"     store: 'sqlserver',",
				"     schemaName: 'dbo',",
				"     tableName: 'Wymiar_Czas',",
				"     insertable: true,",
				"     updateable: false,",
				"     deletable: false,",
				"     upsertable: true,",
				"     keys:['Data'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          Data = DATA,",
				"          Dzien,",
				"          Miesiac,",
				"          Rok,",
				"          Mieszkancy = {Mieszkańcy},",
				"          Wyborcy,",
				"          Liczba_Komisji = {Liczba Komisji}",
				"     )) ~> LoadWymiarCzas2019"
			]
		}
	}
}