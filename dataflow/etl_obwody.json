			"scriptLines": [
				"source(output(",
				"          {KOD TERYTORIALNY} as integer,",
				"          Gmina as string,",
				"          {Numer obwodu} as integer,",
				"          {Numer okręgu do Sejmu} as integer,",
				"          {Numer okręgu do Senatu} as integer,",
				"          {Mieszkańcy} as integer,",
				"          Wyborcy as integer,",
				"          Siedziba as string,",
				"          Ulica as string,",
				"          {Numer posesji} as string,",
				"          {Numer lokalu} as string,",
				"          {Miejscowość} as string,",
				"          {Kod pocztowy} as string,",
				"          Poczta as string,",
				"          {Przystosowany dla niepełnosprawnych} as string,",
				"          {Opis granic} as string,",
				"          {Typ obszaru} as string,",
				"          {Typ obwodu} as string,",
				"          {Pełna siedziba} as string",
				"     ),",
				"     useSchema: false,",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'delimited',",
				"     container: 'plikicsv',",
				"     fileName: 'obwody_glosowania_2015.csv',",
				"     columnDelimiter: ';',",
				"     escapeChar: '\\\\',",
				"     quoteChar: '\\\"',",
				"     columnNamesAsHeader: true) ~> obwody2015",
				"source(output(",
				"          {KOD TERYTORIALNY} as integer,",
				"          Gmina as string,",
				"          Powiat as string,",
				"          {Numer obwodu} as integer,",
				"          {Mieszkańcy} as integer,",
				"          Wyborcy as integer,",
				"          Siedziba as string,",
				"          {Miejscowość} as string,",
				"          Ulica as string,",
				"          {Numer posesji} as string,",
				"          {Numer lokalu} as string,",
				"          {Kod pocztowy} as string,",
				"          Poczta as string,",
				"          {Typ obwodu} as string,",
				"          {Przystosowany dla niepełnosprawnych} as string,",
				"          {Typ obszaru} as string,",
				"          {Pełna siedziba} as string,",
				"          {Opis granic} as string,",
				"          {Numer okręgu do Sejmu} as integer,",
				"          {Numer okręgu do Senatu} as integer",
				"     ),",
				"     useSchema: false,",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'delimited',",
				"     container: 'plikicsv',",
				"     fileName: 'obwody_glosowania_2019.csv',",
				"     columnDelimiter: ';',",
				"     escapeChar: '\\\\',",
				"     quoteChar: '\\\"',",
				"     columnNamesAsHeader: true) ~> obwody2019",
				"source(output(",
				"          {KOD TERYTORIALNY} as integer,",
				"          Gmina as string,",
				"          Powiat as string,",
				"          {Województwo} as string,",
				"          {Numer okręgu do Sejmu} as integer,",
				"          {Numer okręgu do Senatu} as integer,",
				"          {Numer obwodu} as integer,",
				"          {Mieszkańcy} as integer,",
				"          Wyborcy as integer,",
				"          Siedziba as string,",
				"          {Miejscowość} as string,",
				"          Ulica as string,",
				"          {Numer posesji} as string,",
				"          {Numer lokalu} as string,",
				"          {Kod pocztowy} as string,",
				"          Poczta as string,",
				"          {Typ obwodu} as string,",
				"          {Przystosowany dla niepełnosprawnych} as string,",
				"          {Typ obszaru} as string,",
				"          {Pełna siedziba} as string,",
				"          {Opis granic} as string",
				"     ),",
				"     useSchema: false,",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'delimited',",
				"     container: 'plikicsv',",
				"     fileName: 'obwody_glosowania_2023.csv',",
				"     columnDelimiter: ';',",
				"     escapeChar: '\\\\',",
				"     quoteChar: '\\\"',",
				"     columnNamesAsHeader: true) ~> obwody2023",
				"obwody2015 select(mapColumn(",
				"          {KOD TERYTORIALNY},",
				"          Gmina,",
				"          {Numer obwodu},",
				"          {Numer okręgu do Sejmu},",
				"          {Numer okręgu do Senatu},",
				"          {Mieszkańcy},",
				"          Wyborcy,",
				"          Siedziba,",
				"          Ulica,",
				"          {Numer posesji},",
				"          {Numer lokalu},",
				"          {Miejscowość},",
				"          {Kod pocztowy},",
				"          Poczta,",
				"          {Przystosowany dla niepełnosprawnych},",
				"          {Typ obszaru},",
				"          {Typ obwodu}",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> RemoveColumnsObwody2015",
				"RemoveColumnsObwody2015 derive({ID KOMISJI} = toInteger(concat(toString({KOD TERYTORIALNY}), toString({Numer obwodu}))),",
				"          DATA = toDate('25-10-2015', 'dd-MM-yyyy')) ~> IDandRokObwody2015",
				"RemoveColumnsObwody2019 derive({ID KOMISJI} = toInteger(concat(toString({KOD TERYTORIALNY}), toString({Numer obwodu}))),",
				"          DATA = toDate('13-10-2019', 'dd-MM-yyyy'),",
				"          {Przystosowany dla niepełnosprawnych} = case({Przystosowany dla niepełnosprawnych string} == 'Tak', 'T', 'N')) ~> IDandRokObwody2019",
				"obwody2019 select(mapColumn(",
				"          {KOD TERYTORIALNY},",
				"          Gmina,",
				"          {Numer obwodu},",
				"          {Mieszkańcy},",
				"          Wyborcy,",
				"          Siedziba,",
				"          {Miejscowość},",
				"          Ulica,",
				"          {Numer posesji},",
				"          {Numer lokalu},",
				"          {Kod pocztowy},",
				"          Poczta,",
				"          {Typ obwodu},",
				"          {Przystosowany dla niepełnosprawnych string} = {Przystosowany dla niepełnosprawnych},",
				"          {Typ obszaru},",
				"          {Numer okręgu do Sejmu},",
				"          {Numer okręgu do Senatu}",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> RemoveColumnsObwody2019",
				"obwody2023 select(mapColumn(",
				"          {KOD TERYTORIALNY},",
				"          Gmina,",
				"          {Numer okręgu do Sejmu},",
				"          {Numer okręgu do Senatu},",
				"          {Numer obwodu},",
				"          {Mieszkańcy},",
				"          Wyborcy,",
				"          Siedziba,",
				"          {Miejscowość},",
				"          Ulica,",
				"          {Numer posesji},",
				"          {Numer lokalu},",
				"          {Kod pocztowy},",
				"          Poczta,",
				"          {Typ obwodu},",
				"          {Przystosowany dla niepełnosprawnych string} = {Przystosowany dla niepełnosprawnych},",
				"          {Typ obszaru}",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> RemoveColumnsObwody2023",
				"RemoveColumnsObwody2023 derive({ID KOMISJI} = toInteger(concat(toString({KOD TERYTORIALNY}), toString({Numer obwodu}))),",
				"          DATA = toDate('15-10-2023', 'dd-MM-yyyy'),",
				"          {Przystosowany dla niepełnosprawnych} = case(    {Przystosowany dla niepełnosprawnych string} == 'Tak', 'T',    'N')) ~> IDandRokObwody2023",
				"IDandRokObwody2015 alterRow(upsertIf(true())) ~> alterRowWymiarObwody2015",
				"IDandRokObwody2019 alterRow(upsertIf(true())) ~> alterRowWymiarObwody2019",
				"IDandRokObwody2023 alterRow(upsertIf(true())) ~> alterRowWymiarObwody2023",
				"IDandRokObwody2015 aggregate(groupBy(Gmina),",
				"     {Mieszkańcy} = toInteger(sum({Mieszkańcy})),",
				"          Wyborcy = toInteger(sum(Wyborcy)),",
				"          {Liczba Komisji} = toInteger(count({ID KOMISJI}))) ~> AgregateWymiarGmina2015",
				"AddedRokWymiarGmina2015 alterRow(upsertIf(true())) ~> alterRowWymiarGmina2017",
				"IDandRokObwody2019 aggregate(groupBy(Gmina),",
				"     {Mieszkańcy} = toInteger(sum({Mieszkańcy})),",
				"          Wyborcy = toInteger(sum(Wyborcy)),",
				"          {Liczba Komisji} = toInteger(count({ID KOMISJI}))) ~> AgregateWymiarGmina2019",
				"AddedRokWymiarGmina2019 alterRow(upsertIf(true())) ~> alterRowWymiarGmina2019",
				"IDandRokObwody2023 aggregate(groupBy(Gmina),",
				"     {Mieszkańcy} = toInteger(sum({Mieszkańcy})),",
				"          Wyborcy = toInteger(sum(Wyborcy)),",
				"          {Liczba Komisji} = toInteger(count({ID KOMISJI}))) ~> AgregateWymiarGmina2023",
				"AddedRokWymiarGmina2023 alterRow(upsertIf(true())) ~> alterRowWymiarGmina2023",
				"AgregateWymiarGmina2019 derive(ROK = toDate('13-10-2019', 'dd-MM-yyyy')) ~> AddedRokWymiarGmina2019",
				"AgregateWymiarGmina2015 derive(ROK = toDate('25-10-2015', 'dd-MM-yyyy')) ~> AddedRokWymiarGmina2015",
				"AgregateWymiarGmina2023 derive(ROK = toDate('15-10-2023', 'dd-MM-yyyy')) ~> AddedRokWymiarGmina2023",
				"IDandRokObwody2015 aggregate(groupBy(DATA),",
				"     {Mieszkańcy} = toInteger(sum({Mieszkańcy})),",
				"          Wyborcy = toInteger(sum(Wyborcy)),",
				"          {Liczba Komisji} = toInteger(count({ID KOMISJI}))) ~> aggregateWymiarCzas2015",
				"aggregateWymiarCzas2015 derive(Dzien = toInteger(25),",
				"          Miesiac = toInteger(10),",
				"          Rok = toInteger(2015)) ~> derivedColumn1",
				"derivedColumn1 alterRow(upsertIf(true())) ~> alterRowWymiarCzas2015",
				"IDandRokObwody2019 aggregate(groupBy(DATA),",
				"     {Mieszkańcy} = toInteger(sum({Mieszkańcy})),",
				"          Wyborcy = toInteger(sum(Wyborcy)),",
				"          {Liczba Komisji} = toInteger(count({ID KOMISJI}))) ~> aggregateWymiarCzas2019",
				"aggregateWymiarCzas2019 derive(Dzien = toInteger(13),",
				"          Miesiac = toInteger(10),",
				"          Rok = toInteger(2019)) ~> derivedColumn2",
				"derivedColumn2 alterRow(upsertIf(true())) ~> alterRowWymiarCzas2019",
				"IDandRokObwody2023 aggregate(groupBy(DATA),",
				"     {Mieszkańcy} = toInteger(sum({Mieszkańcy})),",
				"          Wyborcy = toInteger(sum(Wyborcy)),",
				"          {Liczba Komisji} = toInteger(count({ID KOMISJI}))) ~> aggregateWymiarCzas2023",
				"aggregateWymiarCzas2023 derive(Dzien = toInteger(15),",
				"          Miesiac = toInteger(10),",
				"          Rok = toInteger(2023)) ~> derivedColumn3",
				"derivedColumn3 alterRow(upsertIf(true())) ~> alterRowWymiarCzas2023",
				"alterRowWymiarObwody2015 sink(allowSchemaDrift: true,",
				"     validateSchema: true,",
				"     input(",
				"          ID_KOMISJI as integer,",
				"          KOD_TERYTORIALNY as integer,",
				"          Gmina as string,",
				"          Numer_obwodu as integer,",
				"          Numer_okregu_do_Sejmu as integer,",
				"          Numer_okregu_do_Senatu as integer,",
				"          Mieszkancy as integer,",
				"          Wyborcy as integer,",
				"          Siedziba as string,",
				"          Ulica as string,",
				"          Numer_posesji as string,",
				"          Numer_lokalu as string,",
				"          Miejscowosc as string,",
				"          Kod_pocztowy as string,",
				"          Poczta as string,",
				"          Przystosowany_dla_niepelnosprawnych as string,",
				"          Typ_obszaru as string,",
				"          Typ_obwodu as string,",
				"          Data as date",
				"     ),",
				"     format: 'table',",
				"     store: 'sqlserver',",
				"     schemaName: 'dbo',",
				"     tableName: 'Wymiar_Obwody_2015',",
				"     insertable: true,",
				"     updateable: false,",
				"     deletable: false,",
				"     upsertable: true,",
				"     keys:['ID_KOMISJI'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          KOD_TERYTORIALNY = {KOD TERYTORIALNY},",
				"          Gmina,",
				"          Numer_obwodu = {Numer obwodu},",
				"          Numer_okregu_do_Sejmu = {Numer okręgu do Sejmu},",
				"          Numer_okregu_do_Senatu = {Numer okręgu do Senatu},",
				"          Mieszkancy = {Mieszkańcy},",
				"          Wyborcy,",
				"          Siedziba,",
				"          Ulica,",
				"          Numer_posesji = {Numer posesji},",
				"          Numer_lokalu = {Numer lokalu},",
				"          Miejscowosc = {Miejscowość},",
				"          Kod_pocztowy = {Kod pocztowy},",
				"          Poczta,",
				"          Przystosowany_dla_niepelnosprawnych = {Przystosowany dla niepełnosprawnych},",
				"          Typ_obszaru = {Typ obszaru},",
				"          Typ_obwodu = {Typ obwodu},",
				"          ID_KOMISJI = {ID KOMISJI},",
				"          Data = DATA",
				"     )) ~> LoadWymiarObwody2015",
				"alterRowWymiarObwody2019 sink(allowSchemaDrift: true,",
				"     validateSchema: true,",
				"     input(",
				"          ID_KOMISJI as integer,",
				"          KOD_TERYTORIALNY as integer,",
				"          Gmina as string,",
				"          Numer_obwodu as integer,",
				"          Numer_okregu_do_Sejmu as integer,",
				"          Numer_okregu_do_Senatu as integer,",
				"          Mieszkancy as integer,",
				"          Wyborcy as integer,",
				"          Siedziba as string,",
				"          Ulica as string,",
				"          Numer_posesji as string,",
				"          Numer_lokalu as string,",
				"          Miejscowosc as string,",
				"          Kod_pocztowy as string,",
				"          Poczta as string,",
				"          Przystosowany_dla_niepelnosprawnych as string,",
				"          Typ_obszaru as string,",
				"          Typ_obwodu as string,",
				"          Data as date",
				"     ),",
				"     format: 'table',",
				"     store: 'sqlserver',",
				"     schemaName: 'dbo',",
				"     tableName: 'Wymiar_Obwody_2019',",
				"     insertable: true,",
				"     updateable: false,",
				"     deletable: false,",
				"     upsertable: true,",
				"     keys:['ID_KOMISJI'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          ID_KOMISJI = {ID KOMISJI},",
				"          KOD_TERYTORIALNY = {KOD TERYTORIALNY},",
				"          Gmina,",
				"          Numer_obwodu = {Numer obwodu},",
				"          Numer_okregu_do_Sejmu = {Numer okręgu do Sejmu},",
				"          Numer_okregu_do_Senatu = {Numer okręgu do Senatu},",
				"          Mieszkancy = {Mieszkańcy},",
				"          Wyborcy,",
				"          Siedziba,",
				"          Ulica,",
				"          Numer_posesji = {Numer posesji},",
				"          Numer_lokalu = {Numer lokalu},",
				"          Miejscowosc = {Miejscowość},",
				"          Kod_pocztowy = {Kod pocztowy},",
				"          Poczta,",
				"          Przystosowany_dla_niepelnosprawnych = {Przystosowany dla niepełnosprawnych},",
				"          Typ_obszaru = {Typ obszaru},",
				"          Typ_obwodu = {Typ obwodu},",
				"          Data = DATA",
				"     )) ~> LoadWymiarObwody2019",
				"alterRowWymiarObwody2023 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ID_KOMISJI as integer,",
				"          KOD_TERYTORIALNY as short,",
				"          Gmina as string,",
				"          Numer_obwodu as short,",
				"          Numer_okregu_do_Sejmu as short,",
				"          Numer_okregu_do_Senatu as short,",
