{
	"name": "agregacja_wyniki_gminy_2019",
	"properties": {
		"folder": {
			"name": "agregacja"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "SQLDatabase",
						"type": "LinkedServiceReference"
					},
					"name": "ReadWyniki2019",
					"description": "Import data from SQLDatabase"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "SQLDatabase",
						"type": "LinkedServiceReference"
					},
					"name": "loadAgregacjaWyniki2019"
				}
			],
			"transformations": [
				{
					"name": "aggregate2019"
				},
				{
					"name": "derived2019",
					"description": "Creating\nData"
				},
				{
					"name": "AlterRow2016"
				}
			],
			"scriptLines": [
				"source(output(",
				"          ID_KOMISJI as integer,",
				"          Kod_Terytorialny as integer,",
				"          Numer_Okregu_Sejm as integer,",
				"          Numer_Obwodu as integer,",
				"          Gmina as string,",
				"          Komisja_Otrzymala_Karty as integer,",
				"          Liczba_Wyborcow as integer,",
				"          Niewykorzystane_Karty as integer,",
				"          Wydane_Karty as integer,",
				"          Liczba_Wyborcow_Pelnomocnik as integer,",
				"          Liczba_Wyborcow_Zaswiadczenie as integer,",
				"          Liczba_Otrzymanych_Kopert as integer,",
				"          Koperty_Brak_Oswiadczenia as integer,",
				"          Koperty_Brak_Podpisu as integer,",
				"          Koperty_Brak_Karty as integer,",
				"          Niezaklejona_Koperta as integer,",
				"          Koperty_Do_Urny as integer,",
				"          Karty_Z_Urny as integer,",
				"          Karty_Z_Kopert as integer,",
				"          Karty_Niewazne as integer,",
				"          Karty_Wazne as integer,",
				"          Glosy_Niewazne as integer,",
				"          Glosy_X_Wielu_Kandydatow as integer,",
				"          Glosy_Brak_X as integer,",
				"          Glosy_X_Uniewazniona_Lista as integer,",
				"          Glosy_Wazne as integer,",
				"          KW_KOALICJA_OBYWATELSKA as integer,",
				"          KW_AKCJA_EMERYTOW_RENCISTOW as integer,",
				"          KW_KONFEDERACJA as integer,",
				"          KW_PSL as integer,",
				"          KW_PRAWICA as integer,",
				"          KW_PIS as integer,",
				"          KW_Skuteczni_Liroy as integer,",
				"          KW_SLD as integer,",
				"          KW_Bezpartyjni_Samorzadowcy as integer,",
				"          KW_Obywatele_Do_Parlamentu as integer,",
				"          Data as date",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table',",
				"     store: 'sqlserver',",
				"     schemaName: 'dbo',",
				"     tableName: 'Fakt_Wyniki_2019',",
				"     isolationLevel: 'READ_UNCOMMITTED') ~> ReadWyniki2019",
				"ReadWyniki2019 aggregate(groupBy(Gmina),",
				"     ID_KOMISJI = count(ID_KOMISJI),",
				"          Liczba_Wyborcow = sum(Liczba_Wyborcow),",
				"          Komisja_Otrzymala_Karty = sum(Komisja_Otrzymala_Karty),",
				"          Niewykorzystane_Karty = sum(Niewykorzystane_Karty),",
				"          Wydane_Karty = sum(Wydane_Karty),",
				"          Liczba_Wyborcow_Pelnomocnik = sum(Liczba_Wyborcow_Pelnomocnik),",
				"          Liczba_Wyborcow_Zaswiadczenie = sum(Liczba_Wyborcow_Zaswiadczenie),",
				"          Liczba_Otrzymanych_Kopert = sum(Liczba_Otrzymanych_Kopert),",
				"          Koperty_Brak_Oswiadczenia = sum(Koperty_Brak_Oswiadczenia),",
				"          Koperty_Brak_Podpisu = sum(Koperty_Brak_Podpisu),",
				"          Koperty_Brak_Karty = sum(Koperty_Brak_Karty),",
				"          Niezaklejona_Koperta = sum(Niezaklejona_Koperta),",
				"          Koperty_Do_Urny = sum(Koperty_Do_Urny),",
				"          Karty_Z_Urny = sum(Karty_Z_Urny),",
				"          Karty_Z_Kopert = sum(Karty_Z_Kopert),",
				"          Karty_Niewazne = sum(Karty_Niewazne),",
				"          Karty_Wazne = sum(Karty_Wazne),",
				"          Glosy_Niewazne = sum(Glosy_Niewazne),",
				"          Glosy_X_Wielu_Kandydatow = sum(Glosy_X_Wielu_Kandydatow),",
				"          Glosy_Brak_X = sum(Glosy_Brak_X),",
				"          Glosy_X_Uniewazniona_Lista = sum(Glosy_X_Uniewazniona_Lista),",
				"          Glosy_Wazne = sum(Glosy_Wazne),",
				"          KW_PIS = sum(KW_PIS),",
				"          KW_KOALICJA_OBYWATELSKA = sum(KW_KOALICJA_OBYWATELSKA),",
				"          KW_KONFEDERACJA = sum(KW_KONFEDERACJA),",
				"          KW_PSL = sum(KW_PSL),",
				"          KW_PRAWICA = sum(KW_PRAWICA),",
				"          KW_AKCJA_EMERYTOW_RENCISTOW = sum(KW_AKCJA_EMERYTOW_RENCISTOW),",
				"          KW_Skuteczni_Liroy = sum(KW_Skuteczni_Liroy),",
				"          KW_SLD = sum(KW_SLD),",
				"          KW_Bezpartyjni_Samorzadowcy = sum(KW_Bezpartyjni_Samorzadowcy),",
				"          KW_Obywatele_Do_Parlamentu = sum(KW_Obywatele_Do_Parlamentu)) ~> aggregate2019",
				"aggregate2019 derive(Data = toDate('13-10-2019', 'dd-MM-yyyy')) ~> derived2019",
				"derived2019 alterRow(upsertIf(true())) ~> AlterRow2016",
				"AlterRow2016 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          Data as date,",
				"          Liczba_Wyborcow_Suma as integer,",
				"          Komisja_Otrzymala_Karty_Suma as integer,",
				"          Niewykorzystane_Karty_Suma as integer,",
				"          Wydane_Karty_Suma as integer,",
				"          Liczba_Wyborcow_Pelnomocnik_Suma as integer,",
				"          Liczba_Wyborcow_Zaswiadczenie_Suma as integer,",
				"          Liczba_Otrzymanych_Kopert_Suma as integer,",
				"          Koperty_Brak_Oswiadczenia_Suma as integer,",
				"          Koperty_Brak_Podpisu_Suma as integer,",
				"          Koperty_Brak_Karty_Suma as integer,",
				"          Niezaklejona_Koperta_Suma as integer,",
				"          Koperty_Do_Urny_Suma as integer,",
				"          Karty_Z_Urny_Suma as integer,",
				"          Karty_Z_Kopert_Suma as integer,",
				"          Karty_Niewazne_Suma as integer,",
				"          Karty_Wazne_Suma as integer,",
				"          Glosy_Niewazne_Suma as integer,",
				"          Glosy_X_Wielu_Kandydatow_Suma as integer,",
				"          Glosy_Brak_X_Suma as integer,",
				"          Glosy_X_Uniewazniona_Lista_Suma as integer,",
				"          Glosy_Wazne_Suma as integer,",
				"          KW_KOALICJA_OBYWATELSKA_Suma as integer,",
				"          KW_AKCJA_EMERYTOW_RENCISTOW_Suma as integer,",
				"          KW_KONFEDERACJA_Suma as integer,",
				"          KW_PSL_Suma as integer,",
				"          KW_PRAWICA_Suma as integer,",
				"          KW_PIS_Suma as integer,",
				"          KW_Skuteczni_Liroy_Suma as integer,",
				"          KW_SLD_Suma as integer,",
				"          KW_Bezpartyjni_Samorzadowcy_Suma as integer,",
				"          KW_Obywatele_Do_Parlamentu_Suma as integer",
				"     ),",
				"     format: 'table',",
				"     store: 'sqlserver',",
				"     schemaName: 'dbo',",
				"     tableName: 'Fakt_Agregowane_Wyniki_2019',",
				"     insertable: true,",
				"     updateable: false,",
				"     deletable: false,",
				"     upsertable: true,",
				"     keys:['Data'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          Data,",
				"          Liczba_Wyborcow_Suma = Liczba_Wyborcow,",
				"          Komisja_Otrzymala_Karty_Suma = Komisja_Otrzymala_Karty,",
				"          Niewykorzystane_Karty_Suma = Niewykorzystane_Karty,",
				"          Wydane_Karty_Suma = Wydane_Karty,",
				"          Liczba_Wyborcow_Pelnomocnik_Suma = Liczba_Wyborcow_Pelnomocnik,",
				"          Liczba_Wyborcow_Zaswiadczenie_Suma = Liczba_Wyborcow_Zaswiadczenie,",
				"          Liczba_Otrzymanych_Kopert_Suma = Liczba_Otrzymanych_Kopert,",
				"          Koperty_Brak_Oswiadczenia_Suma = Koperty_Brak_Oswiadczenia,",
				"          Koperty_Brak_Podpisu_Suma = Koperty_Brak_Podpisu,",
				"          Koperty_Brak_Karty_Suma = Koperty_Brak_Karty,",
				"          Niezaklejona_Koperta_Suma = Niezaklejona_Koperta,",
				"          Koperty_Do_Urny_Suma = Koperty_Do_Urny,",
				"          Karty_Z_Urny_Suma = Karty_Z_Urny,",
				"          Karty_Z_Kopert_Suma = Karty_Z_Kopert,",
				"          Karty_Niewazne_Suma = Karty_Niewazne,",
				"          Karty_Wazne_Suma = Karty_Wazne,",
				"          Glosy_Niewazne_Suma = Glosy_Niewazne,",
				"          Glosy_X_Wielu_Kandydatow_Suma = Glosy_X_Wielu_Kandydatow,",
				"          Glosy_Brak_X_Suma = Glosy_Brak_X,",
				"          Glosy_X_Uniewazniona_Lista_Suma = Glosy_X_Uniewazniona_Lista,",
				"          Glosy_Wazne_Suma = Glosy_Wazne,",
				"          KW_PIS_Suma = KW_PIS,",
				"          KW_KOALICJA_OBYWATELSKA_Suma = KW_KOALICJA_OBYWATELSKA,",
				"          KW_KONFEDERACJA_Suma = KW_KONFEDERACJA,",
				"          KW_PSL_Suma = KW_PSL,",
				"          KW_PRAWICA_Suma = KW_PRAWICA,",
				"          KW_AKCJA_EMERYTOW_RENCISTOW_Suma = KW_AKCJA_EMERYTOW_RENCISTOW,",
				"          KW_Skuteczni_Liroy_Suma = KW_Skuteczni_Liroy,",
				"          KW_SLD_Suma = KW_SLD,",
				"          KW_Bezpartyjni_Samorzadowcy_Suma = KW_Bezpartyjni_Samorzadowcy,",
				"          KW_Obywatele_Do_Parlamentu_Suma = KW_Obywatele_Do_Parlamentu",
				"     )) ~> loadAgregacjaWyniki2019"
			]
		}
	}
}