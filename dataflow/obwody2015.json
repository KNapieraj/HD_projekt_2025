{
	"name": "obwody2015",
	"properties": {
		"folder": {
			"name": "ETL"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "plikicsv",
						"type": "LinkedServiceReference"
					},
					"name": "obwody2015"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "SQLDatabase",
						"type": "LinkedServiceReference"
					},
					"name": "LoadObwody2015"
				}
			],
			"transformations": [
				{
					"name": "RemoveColumnsObwody2015",
					"description": "Remove:\nPelna siedziba,\nOpis granic"
				},
				{
					"name": "IDandROK2015",
					"description": "ID KOMISJI and ROK 2015"
				}
			],
			"scriptLines": [
				"source(output(",
				"          {KOD TERYTORIALNY} as integer,",
				"          Gmina as string,",
				"          {Numer obwodu} as short,",
				"          {Numer okręgu do Sejmu} as short,",
				"          {Numer okręgu do Senatu} as short,",
				"          {Mieszkańcy} as short,",
				"          Wyborcy as short,",
				"          Siedziba as string,",
				"          Ulica as string,",
				"          {Numer posesji} as string,",
				"          {Numer lokalu} as string,",
				"          {Miejscowość} as string,",
				"          {Kod pocztowy} as string,",
				"          Poczta as string,",
				"          {Przystosowany dla niepełnosprawnych} as string,",
				"          {Opis granic} as string,",
				"          {Typ obszaru} as string,",
				"          {Typ obwodu} as string,",
				"          {Pełna siedziba} as string",
				"     ),",
				"     useSchema: false,",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'delimited',",
				"     container: 'hdprojektplikicsv',",
				"     fileName: 'obwody_glosowania_2015.csv',",
				"     columnDelimiter: ';',",
				"     escapeChar: '\\\\',",
				"     quoteChar: '\\\"',",
				"     columnNamesAsHeader: true) ~> obwody2015",
				"obwody2015 select(mapColumn(",
				"          {KOD TERYTORIALNY},",
				"          Gmina,",
				"          {Numer obwodu},",
				"          {Numer okręgu do Sejmu},",
				"          {Numer okręgu do Senatu},",
				"          {Mieszkańcy},",
				"          Wyborcy,",
				"          Siedziba,",
				"          Ulica,",
				"          {Numer posesji},",
				"          {Numer lokalu},",
				"          {Miejscowość},",
				"          {Kod pocztowy},",
				"          Poczta,",
				"          {Przystosowany dla niepełnosprawnych},",
				"          {Typ obszaru},",
				"          {Typ obwodu}",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> RemoveColumnsObwody2015",
				"RemoveColumnsObwody2015 derive({ID KOMISJI} = concat(toString({KOD TERYTORIALNY}), toString({Numer obwodu})),",
				"          ROK = 2015) ~> IDandROK2015",
				"IDandROK2015 sink(allowSchemaDrift: true,",
				"     validateSchema: true,",
				"     input(",
				"          KOD_TERYTORIALNY as short,",
				"          Gmina as string,",
				"          Numer_obwodu as short,",
				"          Numer_okregu_do_Sejmu as short,",
				"          Numer_okregu_do_Senatu as short,",
				"          Mieszkancy as short,",
				"          Wyborcy as short,",
				"          Siedziba as string,",
				"          Ulica as string,",
				"          Numer_posesji as string,",
				"          Numer_lokalu as string,",
				"          Miejscowosc as string,",
				"          Kod_pocztowy as string,",
				"          Poczta as string,",
				"          Przystosowany_dla_niepelnosprawnych as string,",
				"          Typ_obszaru as string,",
				"          Typ_obwodu as string,",
				"          ID_KOMISJI as string,",
				"          ROK as integer",
				"     ),",
				"     format: 'table',",
				"     store: 'sqlserver',",
				"     schemaName: 'dbo',",
				"     tableName: 'Wymiar_Obwody_2015',",
				"     insertable: true,",
				"     updateable: false,",
				"     deletable: false,",
				"     upsertable: false,",
				"     recreate: true,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          KOD_TERYTORIALNY = {KOD TERYTORIALNY},",
				"          Gmina,",
				"          Numer_obwodu = {Numer obwodu},",
				"          Numer_okregu_do_Sejmu = {Numer okręgu do Sejmu},",
				"          Numer_okregu_do_Senatu = {Numer okręgu do Senatu},",
				"          Mieszkancy = {Mieszkańcy},",
				"          Wyborcy,",
				"          Siedziba,",
				"          Ulica,",
				"          Numer_posesji = {Numer posesji},",
				"          Numer_lokalu = {Numer lokalu},",
				"          Miejscowosc = {Miejscowość},",
				"          Kod_pocztowy = {Kod pocztowy},",
				"          Poczta,",
				"          Przystosowany_dla_niepelnosprawnych = {Przystosowany dla niepełnosprawnych},",
				"          Typ_obszaru = {Typ obszaru},",
				"          Typ_obwodu = {Typ obwodu},",
				"          ID_KOMISJI = {ID KOMISJI},",
				"          ROK",
				"     )) ~> LoadObwody2015"
			]
		}
	}
}