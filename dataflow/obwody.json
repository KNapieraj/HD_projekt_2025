{
	"name": "obwody",
	"properties": {
		"folder": {
			"name": "ETL"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "plikicsv",
						"type": "LinkedServiceReference"
					},
					"name": "obwody2015"
				},
				{
					"linkedService": {
						"referenceName": "plikicsv",
						"type": "LinkedServiceReference"
					},
					"name": "obwody2019"
				},
				{
					"linkedService": {
						"referenceName": "plikicsv",
						"type": "LinkedServiceReference"
					},
					"name": "obwody2023"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "SQLDatabase",
						"type": "LinkedServiceReference"
					},
					"name": "LoadObwody2015"
				},
				{
					"linkedService": {
						"referenceName": "SQLDatabase",
						"type": "LinkedServiceReference"
					},
					"name": "LoadObwody2019",
					"description": "LoadObwody2019"
				},
				{
					"linkedService": {
						"referenceName": "SQLDatabase",
						"type": "LinkedServiceReference"
					},
					"name": "LoadObwody2023",
					"description": "LoadObwody2023"
				}
			],
			"transformations": [
				{
					"name": "RemoveColumnsObwody2015",
					"description": "Remove:\nPelna siedziba,\nOpis granic"
				},
				{
					"name": "IDandROKobwody2015",
					"description": "Added\n-ID KOMISJI\n-ROK 2015"
				},
				{
					"name": "IDandROKobwody2019",
					"description": "Added \n-ID KOMISJI \n-ROK 2019"
				},
				{
					"name": "RemoveColumnsObwody2019",
					"description": "Remove:\nPelna siedziba,\nOpis granic\nPowiat"
				},
				{
					"name": "RemoveColumnsObwody2023",
					"description": "Remove:\nPelna siedziba,\nOpis granic\nPowiat\nWojewodztwo"
				},
				{
					"name": "IDandROKobwody2023",
					"description": "Added \n-ID KOMISJI \n-ROK 2023\n"
				}
			],
			"scriptLines": [
				"source(output(",
				"          {KOD TERYTORIALNY} as integer,",
				"          Gmina as string,",
				"          {Numer obwodu} as short,",
				"          {Numer okręgu do Sejmu} as short,",
				"          {Numer okręgu do Senatu} as short,",
				"          {Mieszkańcy} as short,",
				"          Wyborcy as short,",
				"          Siedziba as string,",
				"          Ulica as string,",
				"          {Numer posesji} as string,",
				"          {Numer lokalu} as string,",
				"          {Miejscowość} as string,",
				"          {Kod pocztowy} as string,",
				"          Poczta as string,",
				"          {Przystosowany dla niepełnosprawnych} as string,",
				"          {Opis granic} as string,",
				"          {Typ obszaru} as string,",
				"          {Typ obwodu} as string,",
				"          {Pełna siedziba} as string",
				"     ),",
				"     useSchema: false,",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'delimited',",
				"     container: 'plikicsv',",
				"     fileName: 'obwody_glosowania_2015.csv',",
				"     columnDelimiter: ';',",
				"     escapeChar: '\\\\',",
				"     quoteChar: '\\\"',",
				"     columnNamesAsHeader: true) ~> obwody2015",
				"source(output(",
				"          {KOD TERYTORIALNY} as short,",
				"          Gmina as string,",
				"          Powiat as string,",
				"          {Numer obwodu} as short,",
				"          {Mieszkańcy} as short,",
				"          Wyborcy as short,",
				"          Siedziba as string,",
				"          {Miejscowość} as string,",
				"          Ulica as string,",
				"          {Numer posesji} as string,",
				"          {Numer lokalu} as string,",
				"          {Kod pocztowy} as string,",
				"          Poczta as string,",
				"          {Typ obwodu} as string,",
				"          {Przystosowany dla niepełnosprawnych} as string,",
				"          {Typ obszaru} as string,",
				"          {Pełna siedziba} as string,",
				"          {Opis granic} as string,",
				"          {Numer okręgu do Sejmu} as short,",
				"          {Numer okręgu do Senatu} as short",
				"     ),",
				"     useSchema: false,",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'delimited',",
				"     container: 'plikicsv',",
				"     fileName: 'obwody_glosowania_2019.csv',",
				"     columnDelimiter: ';',",
				"     escapeChar: '\\\\',",
				"     quoteChar: '\\\"',",
				"     columnNamesAsHeader: true) ~> obwody2019",
				"source(output(",
				"          {KOD TERYTORIALNY} as integer,",
				"          Gmina as string,",
				"          Powiat as string,",
				"          {Województwo} as string,",
				"          {Numer okręgu do Sejmu} as integer,",
				"          {Numer okręgu do Senatu} as integer,",
				"          {Numer obwodu} as integer,",
				"          {Mieszkańcy} as integer,",
				"          Wyborcy as integer,",
				"          Siedziba as string,",
				"          {Miejscowość} as string,",
				"          Ulica as string,",
				"          {Numer posesji} as string,",
				"          {Numer lokalu} as string,",
				"          {Kod pocztowy} as string,",
				"          Poczta as string,",
				"          {Typ obwodu} as string,",
				"          {Przystosowany dla niepełnosprawnych} as string,",
				"          {Typ obszaru} as string,",
				"          {Pełna siedziba} as string,",
				"          {Opis granic} as string",
				"     ),",
				"     useSchema: false,",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'delimited',",
				"     container: 'plikicsv',",
				"     fileName: 'obwody_glosowania_2023.csv',",
				"     columnDelimiter: ';',",
				"     escapeChar: '\\\\',",
				"     quoteChar: '\\\"',",
				"     columnNamesAsHeader: true) ~> obwody2023",
				"obwody2015 select(mapColumn(",
				"          {KOD TERYTORIALNY},",
				"          Gmina,",
				"          {Numer obwodu},",
				"          {Numer okręgu do Sejmu},",
				"          {Numer okręgu do Senatu},",
				"          {Mieszkańcy},",
				"          Wyborcy,",
				"          Siedziba,",
				"          Ulica,",
				"          {Numer posesji},",
				"          {Numer lokalu},",
				"          {Miejscowość},",
				"          {Kod pocztowy},",
				"          Poczta,",
				"          {Przystosowany dla niepełnosprawnych},",
				"          {Typ obszaru},",
				"          {Typ obwodu}",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> RemoveColumnsObwody2015",
				"RemoveColumnsObwody2015 derive({ID KOMISJI} = concat(toString({KOD TERYTORIALNY}), toString({Numer obwodu})),",
				"          ROK = toDate('25-10-2015', 'dd-MM-yyyy')) ~> IDandROKobwody2015",
				"RemoveColumnsObwody2019 derive({ID KOMISJI} = concat(toString({KOD TERYTORIALNY}), toString({Numer obwodu})),",
				"          ROK = toDate('13-10-2019', 'dd-MM-yyyy'),",
				"          {Przystosowany dla niepełnosprawnych} = case(\r",
				"    {Przystosowany dla niepełnosprawnych string} == 'Tak', 'T',\r",
				"    'N'\r",
				")) ~> IDandROKobwody2019",
				"obwody2019 select(mapColumn(",
				"          {KOD TERYTORIALNY},",
				"          Gmina,",
				"          {Numer obwodu},",
				"          {Mieszkańcy},",
				"          Wyborcy,",
				"          Siedziba,",
				"          {Miejscowość},",
				"          Ulica,",
				"          {Numer posesji},",
				"          {Numer lokalu},",
				"          {Kod pocztowy},",
				"          Poczta,",
				"          {Typ obwodu},",
				"          {Przystosowany dla niepełnosprawnych string} = {Przystosowany dla niepełnosprawnych},",
				"          {Typ obszaru},",
				"          {Numer okręgu do Sejmu},",
				"          {Numer okręgu do Senatu}",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> RemoveColumnsObwody2019",
				"obwody2023 select(mapColumn(",
				"          {KOD TERYTORIALNY},",
				"          Gmina,",
				"          {Numer okręgu do Sejmu},",
				"          {Numer okręgu do Senatu},",
				"          {Numer obwodu},",
				"          {Mieszkańcy},",
				"          Wyborcy,",
				"          Siedziba,",
				"          {Miejscowość},",
				"          Ulica,",
				"          {Numer posesji},",
				"          {Numer lokalu},",
				"          {Kod pocztowy},",
				"          Poczta,",
				"          {Typ obwodu},",
				"          {Przystosowany dla niepełnosprawnych string} = {Przystosowany dla niepełnosprawnych},",
				"          {Typ obszaru}",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> RemoveColumnsObwody2023",
				"RemoveColumnsObwody2023 derive({ID KOMISJI} = concat(toString({KOD TERYTORIALNY}), toString({Numer obwodu})),",
				"          ROK = toDate('15-10-2023', 'dd-MM-yyyy'),",
				"          {Przystosowany dla niepełnosprawnych} = case(    {Przystosowany dla niepełnosprawnych string} == 'Tak', 'T',    'N')) ~> IDandROKobwody2023",
				"IDandROKobwody2015 sink(allowSchemaDrift: true,",
				"     validateSchema: true,",
				"     input(",
				"          ID_KOMISJI as string,",
				"          KOD_TERYTORIALNY as short,",
				"          Gmina as string,",
				"          Numer_obwodu as short,",
				"          Numer_okregu_do_Sejmu as short,",
				"          Numer_okregu_do_Senatu as short,",
				"          Mieszkancy as short,",
				"          Wyborcy as short,",
				"          Siedziba as string,",
				"          Ulica as string,",
				"          Numer_posesji as string,",
				"          Numer_lokalu as string,",
				"          Miejscowosc as string,",
				"          Kod_pocztowy as string,",
				"          Poczta as string,",
				"          Przystosowany_dla_niepelnosprawnych as string,",
				"          Typ_obszaru as string,",
				"          Typ_obwodu as string,",
				"          Data as date",
				"     ),",
				"     format: 'table',",
				"     store: 'sqlserver',",
				"     schemaName: 'dbo',",
				"     tableName: 'Wymiar_Obwody_2015',",
				"     insertable: true,",
				"     updateable: false,",
				"     deletable: false,",
				"     upsertable: false,",
				"     recreate: true,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          ID_KOMISJI = {ID KOMISJI},",
				"          KOD_TERYTORIALNY = {KOD TERYTORIALNY},",
				"          Gmina,",
				"          Numer_obwodu = {Numer obwodu},",
				"          Numer_okregu_do_Sejmu = {Numer okręgu do Sejmu},",
				"          Numer_okregu_do_Senatu = {Numer okręgu do Senatu},",
				"          Mieszkancy = {Mieszkańcy},",
				"          Wyborcy,",
				"          Siedziba,",
				"          Ulica,",
				"          Numer_posesji = {Numer posesji},",
				"          Numer_lokalu = {Numer lokalu},",
				"          Miejscowosc = {Miejscowość},",
				"          Kod_pocztowy = {Kod pocztowy},",
				"          Poczta,",
				"          Przystosowany_dla_niepelnosprawnych = {Przystosowany dla niepełnosprawnych},",
				"          Typ_obszaru = {Typ obszaru},",
				"          Typ_obwodu = {Typ obwodu},",
				"          Data = ROK",
				"     )) ~> LoadObwody2015",
				"IDandROKobwody2019 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ID_KOMISJI as string,",
				"          KOD_TERYTORIALNY as short,",
				"          Gmina as string,",
				"          Numer_obwodu as short,",
				"          Numer_okregu_do_Sejmu as short,",
				"          Numer_okregu_do_Senatu as short,",
				"          Mieszkancy as short,",
				"          Wyborcy as short,",
				"          Siedziba as string,",
				"          Ulica as string,",
				"          Numer_posesji as string,",
				"          Numer_lokalu as string,",
				"          Miejscowosc as string,",
				"          Kod_pocztowy as string,",
				"          Poczta as string,",
				"          Przystosowany_dla_niepelnosprawnych as string,",
				"          Typ_obszaru as string,",
				"          Typ_obwodu as string,",
				"          Data as date",
				"     ),",
				"     format: 'table',",
				"     store: 'sqlserver',",
				"     schemaName: 'dbo',",
				"     tableName: 'Wymiar_Obwody_2019',",
				"     insertable: true,",
				"     updateable: false,",
				"     deletable: false,",
				"     upsertable: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          ID_KOMISJI = {ID KOMISJI},",
				"          KOD_TERYTORIALNY = {KOD TERYTORIALNY},",
				"          Gmina,",
				"          Numer_obwodu = {Numer obwodu},",
				"          Numer_okregu_do_Sejmu = {Numer okręgu do Sejmu},",
				"          Numer_okregu_do_Senatu = {Numer okręgu do Senatu},",
				"          Mieszkancy = {Mieszkańcy},",
				"          Wyborcy,",
				"          Siedziba,",
				"          Ulica,",
				"          Numer_posesji = {Numer posesji},",
				"          Numer_lokalu = {Numer lokalu},",
				"          Miejscowosc = {Mieszkańcy},",
				"          Kod_pocztowy = {Kod pocztowy},",
				"          Poczta,",
				"          Przystosowany_dla_niepelnosprawnych = {Przystosowany dla niepełnosprawnych string},",
				"          Typ_obszaru = {Typ obszaru},",
				"          Typ_obwodu = {Typ obwodu},",
				"          Data = ROK",
				"     )) ~> LoadObwody2019",
				"IDandROKobwody2023 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ID_KOMISJI as string,",
				"          KOD_TERYTORIALNY as short,",
				"          Gmina as string,",
				"          Numer_obwodu as short,",
				"          Numer_okregu_do_Sejmu as short,",
				"          Numer_okregu_do_Senatu as short,",
				"          Mieszkancy as short,",
				"          Wyborcy as short,",
				"          Siedziba as string,",
				"          Ulica as string,",
				"          Numer_posesji as string,",
				"          Numer_lokalu as string,",
				"          Miejscowosc as string,",
				"          Kod_pocztowy as string,",
				"          Poczta as string,",
				"          Przystosowany_dla_niepelnosprawnych as string,",
				"          Typ_obszaru as string,",
				"          Typ_obwodu as string,",
				"          Data as date",
				"     ),",
				"     format: 'table',",
				"     store: 'sqlserver',",
				"     schemaName: 'dbo',",
				"     tableName: 'Wymiar_Obwody_2023',",
				"     insertable: true,",
				"     updateable: false,",
				"     deletable: false,",
				"     upsertable: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          ID_KOMISJI = {ID KOMISJI},",
				"          KOD_TERYTORIALNY = {KOD TERYTORIALNY},",
				"          Gmina,",
				"          Numer_obwodu = {Numer obwodu},",
				"          Numer_okregu_do_Sejmu = {Numer okręgu do Sejmu},",
				"          Numer_okregu_do_Senatu = {Numer okręgu do Senatu},",
				"          Mieszkancy = {Mieszkańcy},",
				"          Wyborcy,",
				"          Siedziba,",
				"          Ulica,",
				"          Numer_posesji = {Numer posesji},",
				"          Numer_lokalu = {Numer lokalu},",
				"          Miejscowosc = {Miejscowość},",
				"          Kod_pocztowy = {Kod pocztowy},",
				"          Poczta,",
				"          Przystosowany_dla_niepelnosprawnych = {Przystosowany dla niepełnosprawnych string},",
				"          Typ_obszaru = {Typ obszaru},",
				"          Typ_obwodu = {Typ obwodu},",
				"          Data = ROK",
				"     )) ~> LoadObwody2023"
			]
		}
