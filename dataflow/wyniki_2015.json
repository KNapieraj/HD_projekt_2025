		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "SQLDatabase",
						"type": "LinkedServiceReference"
					},
					"name": "Wyniki2015"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          ID_KOMISJI as integer,",
				"          Numer_Okregu_Sejm as integer,",
				"          Kod_Terytorialny as integer,",
				"          Numer_Obwodu as integer,",
				"          Gmina as string,",
				"          Liczba_Wyborcow as integer,",
				"          Komisja_Otrzymala_Karty as integer,",
				"          Niewykorzystane_Karty as integer,",
				"          Wydane_Karty as integer,",
				"          Liczba_Wyborcow_Pelnomocnik as integer,",
				"          Liczba_Wyborcow_Zaswiadczenie as integer,",
				"          Liczba_Otrzymanych_Kopert as integer,",
				"          Koperty_Brak_Oswiadczenia as integer,",
				"          Koperty_Brak_Podpisu as integer,",
				"          Koperty_Brak_Karty as integer,",
				"          Niezaklejona_Koperta as integer,",
				"          Koperty_Do_Urny as integer,",
				"          Karty_Z_Urny as integer,",
				"          Karty_Z_Kopert as integer,",
				"          Karty_Niewazne as integer,",
				"          Karty_Wazne as integer,",
				"          Glosy_Niewazne as integer,",
				"          Glosy_X_Wielu_Kandydatow as integer,",
				"          Glosy_Brak_X as integer,",
				"          Glosy_X_Uniewazniona_Lista as integer,",
				"          Glosy_Wazne as integer,",
				"          KW_PIS as integer,",
				"          KW_KOALICJA_OBYWATELSKA as integer,",
				"          KW_Razem as integer,",
				"          KW_Korwin as integer,",
				"          KW_PSL as integer,",
				"          KW_Zjednoczona_Lewica as integer,",
				"          KW_Kukiz as integer,",
				"          KW_Nowoczesna as integer,",
				"          KW_JOW as integer,",
				"          KW_Stonoga as integer,",
				"          KW_Ruch_Spoleczny as integer,",
				"          KW_Zjednoczeni_Slask as integer,",
				"          KW_Samoobrona as integer,",
				"          KW_Braun_Szczesc_Boze as integer,",
				"          KW_Kongres_Prawicy as integer,",
				"          KW_Mniejszosc_Niemiecka as integer,",
				"          KW_Obywatele_Do_Parlamentu as integer,",
				"          Data as date",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table',",
				"     store: 'sqlserver',",
				"     schemaName: 'dbo',",
				"     tableName: 'Fakt_Wyniki_2015',",
				"     isolationLevel: 'READ_UNCOMMITTED') ~> Wyniki2015",
				"Wyniki2015 aggregate(ID_KOMISJI = count(ID_KOMISJI),",
				"          Liczba_Wyborcow = sum(Liczba_Wyborcow),",
				"          Komisja_Otrzymala_Karty = sum(Komisja_Otrzymala_Karty),",
				"          Niewykorzystane_Karty = sum(Niewykorzystane_Karty),",
				"          Wydane_Karty = sum(Wydane_Karty),",
				"          Liczba_Wyborcow_Pelnomocnik = sum(Liczba_Wyborcow_Pelnomocnik),",
				"          Liczba_Wyborcow_Zaswiadczenie = sum(Liczba_Wyborcow_Zaswiadczenie),",
				"          Liczba_Otrzymanych_Kopert = sum(Liczba_Otrzymanych_Kopert),",
				"          Koperty_Brak_Oswiadczenia = sum(Koperty_Brak_Oswiadczenia),",
				"          Koperty_Brak_Podpisu = sum(Koperty_Brak_Podpisu),",
				"          Koperty_Brak_Karty = sum(Koperty_Brak_Karty),",
				"          Niezaklejona_Koperta = sum(Niezaklejona_Koperta),",
				"          Koperty_Do_Urny = sum(Koperty_Do_Urny),",
				"          Karty_Z_Urny = sum(Karty_Z_Urny),",
				"          Karty_Z_Kopert = sum(Karty_Z_Kopert),",
				"          Karty_Niewazne = sum(Karty_Niewazne),",
				"          Karty_Wazne = sum(Karty_Wazne),",
				"          Glosy_Niewazne = sum(Glosy_Niewazne),",
				"          Glosy_X_Wielu_Kandydatow = sum(Glosy_X_Wielu_Kandydatow),",
				"          Glosy_Brak_X = sum(Glosy_Brak_X),",
				"          Glosy_X_Uniewazniona_Lista = sum(Glosy_X_Uniewazniona_Lista),",
				"          Glosy_Wazne = sum(Glosy_Wazne)) ~> aggregate1"
			]
		}
	}
}